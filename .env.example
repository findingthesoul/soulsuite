# ---- Database ----
# Pooled connection (used by Next.js runtime via Prisma).
# Get from Supabase dashboard → Project Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (used by `prisma migrate`). "Session" pooler or direct 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Service role key — server-only, never exposed to the browser. Used to read auth.identities.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- Google OAuth ----
# Same client ID/secret you configured in the Supabase Auth → Providers → Google panel.
# Needed server-side to construct an OAuth2 client when calling Google APIs.
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"

# ---- App ----
# Used to build absolute URLs in OAuth callbacks and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Domain that workspace members must use. v1 is hard-coded to one workspace; this matches workspace.primaryEmailDomain.
WORKSPACE_PRIMARY_EMAIL_DOMAIN="soul.com"

# Secret used to sign cancel/reschedule and invite tokens. Generate with: openssl rand -base64 32
APP_TOKEN_SECRET="<random-32-byte-base64>"

# ---- Email (later) ----
# RESEND_API_KEY=""
# EMAIL_FROM="Soul <noreply@soul.com>"

# ---- Zoom OAuth (User-managed app at marketplace.zoom.us → Develop → Build App → OAuth) ----
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/oauth/zoom/callback
# Scopes: meeting:write:meeting and user:read:user (granular).
# ZOOM_CLIENT_ID=""
# ZOOM_CLIENT_SECRET=""
