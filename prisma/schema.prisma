// Soul Suite — Prisma schema.
// Mirrors the domain model in soul-scheduler-brief.md (filename predates the rename).
// Three layers: Workspace → Project → Personal.
//
// Cross-table slug uniqueness (Host.slug ⊥ Project.slug) is enforced at the application layer
// via src/lib/slugs.ts inside a transaction. A future raw-SQL migration should add a Postgres
// trigger to back this up at the DB level — see brief §"Slug collisions".

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Workspace + membership
// ────────────────────────────────────────────────────────────────────────────

model Workspace {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  primaryEmailDomain String
  // Branding — surfaced in the app header and (later) public booking pages.
  logoUrl            String?
  brandColor         String? // hex like "#1c1917"
  createdAt          DateTime @default(now())

  members  WorkspaceMember[]
  projects Project[]
  invites  Invite[]
  contacts Contact[]
}

// ────────────────────────────────────────────────────────────────────────────
// Contacts — workspace-scoped directory, auto-built from booking history.
// On every booking creation we upsert a Contact row keyed by (workspaceId, email).
// Manually-edited fields are never overwritten by the upsert (see src/lib/contacts.ts).
// ────────────────────────────────────────────────────────────────────────────

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  phone       String?
  company     String?
  jobTitle    String?
  linkedinUrl String?
  location    String?
  timeZone    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  hostId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host      Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, hostId])
  @@index([hostId])
}

// ────────────────────────────────────────────────────────────────────────────
// Host (one per Google identity) + their calendars
// ────────────────────────────────────────────────────────────────────────────

model Host {
  id                 String    @id @default(cuid())
  // Mirrors auth.users.id in Supabase Auth so we can join cleanly.
  authUserId         String    @unique
  email              String    @unique
  name               String
  slug               String    @unique
  // Cached from auth.identities.identity_data.provider_refresh_token. Refreshed on every sign-in.
  // Nullable because Supabase doesn't always surface it on the very first callback.
  googleRefreshToken String?
  // Zoom OAuth (User-managed). Captured in /api/oauth/zoom/callback. Null = not connected.
  zoomRefreshToken   String?
  zoomAccountEmail   String?
  zoomConnectedAt    DateTime?
  // Stripe Connect Standard — host pastes their account ID (acct_…) on /settings/payments.
  // Null = no Stripe connected; paid meeting types blocked from saving until set.
  stripeAccountId    String?
  // How this host wants to deliver invoices for INVOICE-method bookings.
  // EXTERNAL (default): Soul Suite confirms the booking and the host invoices from another app.
  // SOUL_SUITE: Soul Suite generates a Stripe payment link, emails the invoice, and the
  // INVOICE_PENDING → INVOICE_SENT → PAID transitions are driven automatically by the webhook.
  // Selectable in the UI only when stripeAccountId is set.
  invoiceSource      InvoiceSource @default(EXTERNAL)
  timezone           String    @default("Europe/Amsterdam")
  // JSON shape: { mon: [{start: "09:00", end: "17:00"}], tue: [...], ... }
  workingHours       Json?
  // Profile fields (host-editable on /settings/profile). All optional.
  phone              String?
  location           String?
  bio                String?
  photoUrl           String?
  // Persistent personal meeting URL — host's Zoom Personal Meeting Room, Google Meet permanent
  // room, Whereby room, etc. Used by meeting types with conferencingProvider=PERSONAL_ROOM:
  // every booking simply hands this URL to the invitee instead of generating a fresh meeting.
  personalRoomUrl    String?
  createdAt          DateTime  @default(now())

  calendars            Calendar[]
  workspaceMembers     WorkspaceMember[]
  projectMembers       ProjectMember[]
  personalMeetingTypes MeetingType[]     @relation("PersonalMeetingTypeHost")
  personalIntakeForms  IntakeForm[]      @relation("PersonalIntakeFormHost")
  personalPolls        Poll[]            @relation("PersonalPollHost")
  ownedPolls           Poll[]            @relation("PollOwner")
  bookings             Booking[]
  invitesSent          Invite[]          @relation("InviteSender")
  conferencingHostFor  MeetingType[]     @relation("MeetingTypeConferencingHost")
}

enum CalendarRole {
  PRIMARY
  CONFLICT_CHECK
  WRITE_TARGET
}

model Calendar {
  id               String       @id @default(cuid())
  hostId           String
  googleCalendarId String
  summary          String?
  role             CalendarRole
  createdAt        DateTime     @default(now())

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, googleCalendarId])
  @@index([hostId])
}

// ────────────────────────────────────────────────────────────────────────────
// Project + membership (workspace members or external collaborators)
// ────────────────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  // Per-team round-robin fairness rule. Default LEAST_RECENTLY_ASSIGNED matches the brief's
  // pre-feature behaviour. See src/lib/round-robin.ts for the implementation of each rule.
  roundRobinFairness RoundRobinFairness @default(LEAST_RECENTLY_ASSIGNED)
  createdAt   DateTime @default(now())

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  meetingTypes MeetingType[]   @relation("ProjectMeetingType")
  intakeForms  IntakeForm[]    @relation("ProjectIntakeForm")
  polls        Poll[]          @relation("ProjectPoll")
  bookings     Booking[]
  invites      Invite[]

  @@index([workspaceId])
}

enum ProjectRole {
  LEAD
  MEMBER
}

// Round-robin fairness rule (per Project). LEAST_RECENTLY_ASSIGNED is the historic default
// (oldest ProjectMember.lastAssignedAt wins, nulls first). LEAST_LOADED counts upcoming
// confirmed bookings in the next 14 days and prefers the host with the fewest, tie-breaking
// on least-recently-assigned. STRICT_ROTATION rotates through assignedHostIds in order using
// the most recent Booking row to find "last assigned". RANDOM picks uniformly at random.
enum RoundRobinFairness {
  LEAST_RECENTLY_ASSIGNED
  LEAST_LOADED
  STRICT_ROTATION
  RANDOM
}

model ProjectMember {
  id             String      @id @default(cuid())
  projectId      String
  hostId         String
  role           ProjectRole @default(MEMBER)
  isExternal     Boolean     @default(false)
  addedAt        DateTime    @default(now())
  // Round-robin fairness: tracks when this member was last assigned a booking via
  // ROUND_ROBIN. Null means "never been assigned yet" → ranks first (oldest first).
  lastAssignedAt DateTime?
  // Optional per-project override of this host's default working hours when scheduling for
  // this team. Same JSON shape as Host.workingHours (Record<DayKey, { start, end }[]>).
  // Resolution order in the availability engine: meetingType.workingHoursOverride →
  // projectMember.workingHoursOverride (project-scoped MTs only) → host.workingHours.
  // Null/empty = fall back to the next layer.
  workingHoursOverride Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  host    Host    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([projectId, hostId])
  @@index([hostId])
}

// ────────────────────────────────────────────────────────────────────────────
// Meeting types + intake forms
// ────────────────────────────────────────────────────────────────────────────

enum ConferencingProvider {
  GOOGLE_MEET
  ZOOM
  TEAMS
  IN_PERSON
  PERSONAL_ROOM
  NONE
}

enum Scope {
  PERSONAL
  PROJECT
}

enum RoutingMode {
  SINGLE
  ROUND_ROBIN
  COLLECTIVE
}

model MeetingType {
  id                    String               @id @default(cuid())
  scope                 Scope
  hostId                String? // set when scope = PERSONAL
  projectId             String? // set when scope = PROJECT
  slug                  String
  name                  String
  description           String?
  durationMinutes       Int
  bufferBeforeMinutes   Int                  @default(0)
  bufferAfterMinutes    Int                  @default(0)
  minNoticeMinutes      Int                  @default(60)
  maxAdvanceDays        Int                  @default(60)
  routingMode           RoutingMode          @default(SINGLE)
  // Group meetings: how many invitees can claim the same slot. 1 = traditional 1:1 meeting,
  // >1 = shared event (single Google event, many bookings rows). Only valid for SINGLE routing.
  maxInvitees           Int                  @default(1)
  // For project scope round-robin: hostIds drawn from ProjectMember.hostId.
  // Validation lives in src/lib/meeting-types.ts.
  assignedHostIds       String[]
  // Optional per-meeting-type override of which Calendar.id rows count as conflict sources.
  // Empty = use the host's default conflict-source set (CONFLICT_CHECK + WRITE_TARGET roles).
  conflictCalendarIds   String[]
  // Optional per-meeting-type override of the host's default working hours. Same JSON shape as
  // Host.workingHours (Record<DayKey, { start, end }[]>). Null/empty/{} = fall back to the host's
  // weekly schedule. For PROJECT meeting types, the override applies to every assigned host —
  // the same wall-clock windows in each host's local timezone.
  workingHoursOverride  Json?
  intakeFormId          String?
  // Privacy: by default intake answers are not added to the calendar event description (brief §Privacy).
  includeAnswersInEvent Boolean              @default(false)
  // Which conferencing system to attach to the booking. GOOGLE_MEET is the legacy default;
  // ZOOM/TEAMS require the host to have connected the corresponding provider in /settings/connections.
  conferencingProvider  ConferencingProvider @default(GOOGLE_MEET)
  // For IN_PERSON conferencing: the address/room/hint shown on the booking page and written to
  // the Google calendar event's `location` field. Required when conferencingProvider=IN_PERSON.
  // Other providers ignore this field; the value is preserved on switch-away (no destructive
  // clear) so flipping back to IN_PERSON keeps the previous location.
  defaultLocation       String?
  // For COLLECTIVE routing: which assigned host's account creates the conferencing meeting (Zoom
  // meeting / Google Meet event owner). Other assigned hosts are added as alternative hosts (Zoom)
  // or attendees (Google Meet). Null for SINGLE / ROUND_ROBIN — those modes derive the host from
  // the booking flow itself.
  conferencingHostId    String?
  conferencingHost      Host?                @relation("MeetingTypeConferencingHost", fields: [conferencingHostId], references: [id], onDelete: SetNull)
  isActive              Boolean              @default(true)
  // One-off meetings: when true, the host hand-picks specific date/time slots (stored as
  // OneOffSlot rows) instead of using working hours + availability engine. Hidden from regular
  // meeting-type lists; surfaced under a dedicated dashboard section.
  isOneOff              Boolean              @default(false)
  // Pricing — paid meeting types route the invitee through Stripe Checkout before the booking
  // is finalised. Null/0 priceCents = free (existing flow). priceCurrency is ISO-4217 lowercase
  // (eur, usd, gbp). Validation in the MT API blocks save when priceCents > 0 and the host has
  // no stripeAccountId.
  priceCents            Int?
  priceCurrency         String?
  // Which payment rail to use for paid bookings on this MT. STRIPE (default) routes through
  // Stripe Checkout. INVOICE collects billing details from the invitee and confirms the booking
  // immediately — the host invoices manually. No-op when priceCents is null/0 (free MT).
  paymentMethod         PaymentMethod        @default(STRIPE)
  createdAt             DateTime             @default(now())

  host       Host?            @relation("PersonalMeetingTypeHost", fields: [hostId], references: [id], onDelete: Cascade)
  project    Project?         @relation("ProjectMeetingType", fields: [projectId], references: [id], onDelete: Cascade)
  intakeForm IntakeForm?      @relation(fields: [intakeFormId], references: [id], onDelete: SetNull)
  bookings    Booking[]
  rrState     RoundRobinState?
  oneOffSlots OneOffSlot[]

  // Slug is unique within its scope (per host or per project), not globally.
  @@unique([hostId, slug])
  @@unique([projectId, slug])
  @@index([scope])
}

model IntakeForm {
  id        String   @id @default(cuid())
  scope     Scope
  hostId    String?
  projectId String?
  name      String
  // JSON shape:
  //   [{ key, label, type: 'short'|'long'|'email'|'select'|'multi'|'checkbox',
  //      required, options?, conditionalOn?: { fieldKey, equals } }]
  fields    Json
  createdAt DateTime @default(now())

  host         Host?         @relation("PersonalIntakeFormHost", fields: [hostId], references: [id], onDelete: Cascade)
  project      Project?      @relation("ProjectIntakeForm", fields: [projectId], references: [id], onDelete: Cascade)
  meetingTypes MeetingType[]

  @@index([hostId])
  @@index([projectId])
}

// ────────────────────────────────────────────────────────────────────────────
// Bookings
// ────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

// Payment lifecycle for paid meeting types. NOT_REQUIRED = free MT (default). PENDING = Stripe
// Checkout session opened, awaiting webhook. PAID = checkout completed and the booking has been
// finalised (Google + emails). FAILED = expired or payment intent failed. REFUNDED = manual.
// INVOICE_PENDING / INVOICE_SENT cover the invoice-payment branch — the booking is confirmed and
// finalised on creation, and the host transitions through these statuses manually from the
// admin Payments page (Mark as invoiced → Mark as paid). No money moves in our system.
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
  INVOICE_PENDING
  INVOICE_SENT
  // The invoice was voided (credit note issued / Stripe payment link deactivated). Used when
  // the booking is cancelled and no money has been collected yet — distinct from REFUNDED,
  // which means money WAS collected and was paid back. For Soul-Suite-issued invoices we also
  // deactivate the underlying Stripe payment link so it can't be paid after the fact.
  INVOICE_VOIDED
}

// Which collection rail a paid meeting type uses. STRIPE = Stripe Checkout (existing flow,
// money moves through Stripe Connect). INVOICE = invitee fills in billing details at booking
// time, host invoices manually outside the app. Adyen is intentionally absent from this enum —
// the MT form surfaces it as a disabled "Coming soon" option but rejecting it on save means we
// don't have to write a code path for an enum value with no implementation.
enum PaymentMethod {
  STRIPE
  INVOICE
}

// Per-host invoice delivery mode — see Host.invoiceSource.
enum InvoiceSource {
  EXTERNAL
  SOUL_SUITE
}

model Booking {
  id                   String               @id @default(cuid())
  meetingTypeId        String
  hostId               String // resolved at booking time (round-robin → final host)
  projectId            String? // copied from MeetingType for reporting
  inviteeEmail         String
  inviteeName          String
  inviteeAnswers       Json?
  startsAt             DateTime
  endsAt               DateTime
  googleEventId        String?
  // Conferencing — populated when the booking creates a meeting in Zoom/Teams/Meet. Stored
  // so the cancel route can also tear down the provider-side meeting if needed, and so
  // emails/UI can render the join link without re-fetching from Google.
  conferencingProvider ConferencingProvider @default(GOOGLE_MEET)
  meetUrl              String?
  // Provider-specific meeting id (Zoom meeting id, Teams onlineMeeting id). Null for GOOGLE_MEET
  // since the link lives on the Google event itself and is recreated by Google.
  providerMeetingId    String?
  // Host-editable per-booking location override. When set, it wins over whatever the
  // conferencing provider produced — written to the Google event's `location` field and shown
  // on the public confirmed page. Useful when an auto-Zoom failed (paste a manual link) or to
  // change a venue last-minute. Setting back to null reverts to the provider-generated value.
  alternativeLocation  String?
  // Idempotency key for Google event creation (brief §Idempotency).
  requestId            String               @unique
  status               BookingStatus        @default(CONFIRMED)
  // Payment fields — only meaningful when the meeting type has priceCents > 0. For free MTs the
  // status stays NOT_REQUIRED and stripe* fields stay null. PENDING bookings exist but have no
  // googleEventId / meetUrl yet; the webhook flips PAID and runs finalizeBooking().
  paymentStatus        PaymentStatus        @default(NOT_REQUIRED)
  // Mirrors MeetingType.paymentMethod at booking creation time so future MT-level changes don't
  // mutate the historical record. Always STRIPE for free MTs (the default is harmless there).
  paymentMethod        PaymentMethod        @default(STRIPE)
  // Captured at booking time when paymentMethod = INVOICE. Shape:
  //   { companyName, billingEmail, addressLine1, addressLine2?, postalCode, city,
  //     country, countryOther?, vatId?, reference? }
  // See src/app/[slug]/[meetingTypeSlug]/flow.tsx (BillingPanel) for the canonical form schema.
  invoiceDetails       Json?
  // Soul-Suite-generated invoice delivery (only set when host.invoiceSource = SOUL_SUITE).
  // invoiceNumber is human-readable, unique per workspace (INV-{year}-{seq}).
  // invoicePaymentLinkUrl is the Stripe payment link the invitee opens to pay.
  // invoicePaymentLinkId is the plink_… id, kept so we can deactivate or look it up later.
  // invoiceSentAt is when the invoice email was sent successfully.
  invoiceNumber          String?
  invoicePaymentLinkUrl  String?
  invoicePaymentLinkId   String?
  invoiceSentAt          DateTime?
  stripeSessionId      String?
  stripePaymentIntent  String?
  createdAt            DateTime             @default(now())

  meetingType       MeetingType @relation(fields: [meetingTypeId], references: [id])
  host              Host        @relation(fields: [hostId], references: [id])
  project           Project?    @relation(fields: [projectId], references: [id])
  finalizedFromPoll Poll?       @relation("PollFinalizedBooking")

  @@index([hostId, startsAt])
  @@index([hostId, status, startsAt])
  @@index([projectId])
  @@index([meetingTypeId])
  @@index([meetingTypeId, startsAt])
  @@index([stripeSessionId])
}

// ────────────────────────────────────────────────────────────────────────────
// Polls
// ────────────────────────────────────────────────────────────────────────────

enum PollStatus {
  OPEN
  FINALIZED
  CANCELLED
}

model Poll {
  id                 String     @id @default(cuid())
  scope              Scope
  hostId             String?
  projectId          String?
  ownerHostId        String
  name               String
  durationMinutes    Int
  // JSON shape: [{ id, startsAt, endsAt }]
  proposedSlots      Json
  inviteeEmails      String[]
  status             PollStatus @default(OPEN)
  finalizedSlot      Json?
  finalizedBookingId String?    @unique
  createdAt          DateTime   @default(now())

  host             Host?          @relation("PersonalPollHost", fields: [hostId], references: [id], onDelete: Cascade)
  project          Project?       @relation("ProjectPoll", fields: [projectId], references: [id], onDelete: Cascade)
  owner            Host           @relation("PollOwner", fields: [ownerHostId], references: [id])
  responses        PollResponse[]
  finalizedBooking Booking?       @relation("PollFinalizedBooking", fields: [finalizedBookingId], references: [id])

  @@index([hostId])
  @@index([projectId])
  @@index([ownerHostId, status])
}

model PollResponse {
  id           String   @id @default(cuid())
  pollId       String
  inviteeEmail String
  // JSON shape: { [slotId]: 'YES' | 'NO' | 'MAYBE' }
  votes        Json
  // Signed token used by the public voting page; identifies this invitee without an account.
  token        String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, inviteeEmail])
}

// ────────────────────────────────────────────────────────────────────────────
// Round-robin state — fairness via least-recently-assigned (brief default)
// ────────────────────────────────────────────────────────────────────────────

// ────────────────────────────────────────────────────────────────────────────
// One-off slots — hand-picked time slots for isOneOff meeting types
// ────────────────────────────────────────────────────────────────────────────

model OneOffSlot {
  id               String   @id @default(cuid())
  meetingTypeId    String
  startsAt         DateTime
  endsAt           DateTime
  // Set to the Booking.id once an invitee claims the slot; null = still available.
  // The unique constraint enforces "claim once" semantics.
  bookedBookingId  String?  @unique
  createdAt        DateTime @default(now())

  meetingType MeetingType @relation(fields: [meetingTypeId], references: [id], onDelete: Cascade)

  @@index([meetingTypeId])
  @@unique([meetingTypeId, startsAt])
}

model RoundRobinState {
  meetingTypeId      String   @id
  lastAssignedHostId String?
  updatedAt          DateTime @updatedAt

  meetingType MeetingType @relation(fields: [meetingTypeId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────────
// Invites — workspace + project scope
// ────────────────────────────────────────────────────────────────────────────

enum InviteKind {
  WORKSPACE
  PROJECT
}

model Invite {
  id              String     @id @default(cuid())
  kind            InviteKind
  workspaceId     String?
  projectId       String?
  email           String
  // For WORKSPACE invites: WorkspaceRole. For PROJECT invites: ProjectRole. Stored as string to keep one column.
  role            String
  token           String     @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByHostId String
  createdAt       DateTime   @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy Host       @relation("InviteSender", fields: [invitedByHostId], references: [id])

  @@index([email])
  @@index([workspaceId])
  @@index([projectId])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Reserved route slugs — populated by seed; checked alongside Host/Project on slug creation.
// ────────────────────────────────────────────────────────────────────────────

model ReservedSlug {
  value     String   @id
  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// Invoice numbering — sequential per workspace per year (INV-{year}-{seq}).
// Read-modify-write inside a transaction; the (workspaceId, year) pair is the PK.
// ────────────────────────────────────────────────────────────────────────────

model WorkspaceInvoiceCounter {
  workspaceId String
  year        Int
  lastSeq     Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([workspaceId, year])
}
